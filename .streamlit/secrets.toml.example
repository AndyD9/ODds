# ---------------------------------------------------------------------------
# Secrets de l'application HÉBERGÉE — decisions/0009.
#
# En local : rien de tout ceci n'est nécessaire ; sans ce fichier l'application
# tourne en mode local, sans connexion, sur le carnet du disque.
#
# Sur Streamlit Community Cloud : coller le contenu dans « Settings → Secrets »
# de l'application. Ne jamais commiter un fichier secrets.toml rempli — il est
# dans .gitignore.
# ---------------------------------------------------------------------------

# Qui peut entrer. Adresses Google, séparées par des virgules. Vide = personne.
ODDS_INVITES = "vous@example.com, invite@example.com"

# Le propriétaire : les paris du carnet local historique deviennent les siens.
ODDS_PROPRIETAIRE = "vous@example.com"

# Copie distante de l'état (carnet, base de collecte, parquets) — Supabase
# Storage, seau privé. Les mêmes valeurs vont dans les secrets GitHub du
# workflow de collecte.
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY = ""
SUPABASE_BUCKET = "etat"

# Connexion OpenID Connect — st.login. Client OAuth « application web » créé
# dans Google Cloud Console, avec pour URI de redirection autorisée la valeur
# de redirect_uri ci-dessous (l'URL de l'application + /oauth2callback).
# cookie_secret : une chaîne aléatoire longue, à vous, jamais réutilisée.
[auth]
redirect_uri = "https://votre-application.streamlit.app/oauth2callback"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
