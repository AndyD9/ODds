# ---------------------------------------------------------------------------
# Secrets de l'application HÉBERGÉE — decisions/0009.
#
# En local : rien de tout ceci n'est nécessaire ; sans ce fichier l'application
# tourne en mode local, sans porte d'entrée, sur le carnet du disque.
#
# Sur Streamlit Community Cloud : coller le contenu dans « Settings → Secrets »
# de l'application. Ne jamais commiter un fichier secrets.toml rempli — il est
# dans .gitignore.
# ---------------------------------------------------------------------------

# Le propriétaire : les paris du carnet local historique deviennent les siens.
ODDS_PROPRIETAIRE = "andy"

# Adresse publique de l'application — sert à composer les liens d'invitation.
ODDS_URL = "https://votre-application.streamlit.app"

# Copie distante de l'état (carnet, base de collecte, parquets) — Supabase
# Storage, seau privé. Les mêmes valeurs vont dans les secrets GitHub du
# workflow de collecte.
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY = ""
SUPABASE_BUCKET = "etat"

# Qui peut entrer : un nom d'utilisateur = sa clé personnelle. Chaque invité
# reçoit le lien  <ODDS_URL>/?cle=<clé>  et rien d'autre. `uv run odds inviter
# paul` génère une clé et imprime cette ligne. Révoquer : retirer la ligne.
# Section vide ou absente = personne n'entre… sauf en local, où l'absence
# d'invités signifie « pas de porte ».
[invites]
andy = "remplacer-par-la-sortie-de-odds-inviter"
paul = ""
